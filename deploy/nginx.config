map $http_upgrade $connection_upgrade {
    default upgrade;
    # an empty Connection keeps the connection to the container open for the next request
    ''      '';
}

# nginx keeps a few connections to each container and reuses them; a new connection per request
# made about one request in ten wait a second or more for its connection under load
upstream igroceh_frontend {
    server 127.0.0.1:8081;
    keepalive 16;
}

upstream igroceh_api {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 80;
    server_name gamews.quest;

    location / {
        proxy_pass http://igroceh_frontend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name api.gamews.quest;
    # the banners and the covers are up to 10 MB
    client_max_body_size 11m;

    location / {
        proxy_pass http://igroceh_api;
        proxy_http_version 1.1;
        # the websockets of the events
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}